import java.util.Scanner;
public class Main
{
	public static int  hcf(int a,int b) 
	{
	    while(a!=0 && b!=0)
	    {
	        if(a>b)
	        {
	            a=a%b;
	        }
	        else
	        {
	            b=b%a;
	        }
	    }
	    return a+b;
	}
	public static void main(String[] args)
	{
	    Scanner sc=new Scanner(System.in);
	    int a=sc.nextInt();
	    int b=sc.nextInt();
	    int gcd=hcf(a,b);
	    System.out.print(gcd);
	    
	}
}
