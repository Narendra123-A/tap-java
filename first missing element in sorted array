import java.util.Scanner;
public class Main
{
    public static void missing_element(int arr[])
    {
        int n=arr.length+1;
        int sum=0;
        int total=n*(n+1)/2;
        for(int i=0;i<arr.length;i++)
        {
            sum=sum+arr[i];
        }
        int missing_element=total-sum;
        System.out.print(missing_element);
    }
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int arr[]=new int[n];
		for(int i=0;i<n;i++)
		{
		    arr[i]=sc.nextInt();
		}
		missing_element(arr);
	}
}
