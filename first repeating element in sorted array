import java.util.Scanner;

public class Main
{
    public static void printdistinct(int arr[])
    {
        for(int i = 0; i < arr.length-1; i++)
        {
            if(arr[i]==arr[i+1])
            {
                System.out.println(arr[i]);
                return;
            }
        }
            
        System.out.print(-1);
        
    }

    public static void main(String[] args)
    {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int arr[] = new int[n];

        for(int i = 0; i < n; i++)
        {
            arr[i] = sc.nextInt();
        }

        printdistinct(arr);
    }
}
