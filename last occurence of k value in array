import java.util.*;
public class Main
{
    public static int LastOccurence(int arr[],int k)
    {
        for(int i=arr.length-1;i>=0;i--)
        {
            if(arr[i]==k)
            {
                return i;
            }
        }
        return -1;
    }
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int arr[]=new int[n];
		for(int i=0;i<n;i++)
		{
		    arr[i]=sc.nextInt();
		}
		int k=sc.nextInt();
		int result=LastOccurence(arr,k);
		System.out.print(result);
	}
}
