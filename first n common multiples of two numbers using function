import java.util.Scanner;
public class Main
{
	public static void multiples(int a,int b,int n) 
	{
	    int count=0;
		for(int i=1;count<n;i++)
		{
		    if(i%a==0 && i%b==0)
		    {
		        System.out.print(i+" ");
		        count++;
		    }
		}
	}
	public static void main(String[] args)
	{
	    Scanner sc=new Scanner(System.in);
	    int a=sc.nextInt();
	    int b=sc.nextInt();
	    int n=sc.nextInt();
	    multiples(a,b,n);
	    
	}
}
