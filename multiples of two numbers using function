import java.util.Scanner;
public class Main
{
	public static void multiples(int n1,int n2,int x) 
	{
		for(int i=1;i<=x;i++)
		{
		    if(i%n1==0 && i%n2==0)
		    {
		        System.out.print(i+" ");
		    }
		}
	}
	public static void main(String[] args)
	{
	    Scanner sc=new Scanner(System.in);
	    int n1=sc.nextInt();
	    int n2=sc.nextInt();
	    int x=sc.nextInt();
	    multiples(n1,n2,x);
	    
	}
}
