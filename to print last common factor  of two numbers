import java.util.Scanner;
public class Main
{
	public static void multiples(int n1,int n2) 
	{
	    int min=n1<n2 ? n1:n2;
		for(int i=min;i>=1;i--)
		{
		    if(n1%i==0 && n2%i==0)
		    {
		        System.out.print(i+" ");
		        break;
		    }
		}
	}
	public static void main(String[] args)
	{
	    Scanner sc=new Scanner(System.in);
	    int n1=sc.nextInt();
	    int n2=sc.nextInt();
	    multiples(n1,n2);
	    
	}
}
