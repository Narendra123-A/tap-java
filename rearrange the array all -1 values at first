import java.util.Scanner;
public class Main
{
    public static int[] rearrangearray(int arr[])
    {
        int i=arr.length-1,j=arr.length-1;
        while(i>=0)
        {
            if(arr[i]==-1)
            {
                i--;
            }
            else
            {
                arr[j]=arr[i];
                j--;
                i--;
            }
        }
        while(j>=0)
        {
            arr[j]=-1;
            j--;
        }
        return arr;
       
        
    }
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int arr[]=new int[n];
		for(int i=0;i<n;i++)
		{
		    arr[i]=sc.nextInt();
		}
		int res[]=rearrangearray(arr);
		for(int i=0;i<n;i++)
		{
		    System.out.print(arr[i]+" ");
		}
	}
}
