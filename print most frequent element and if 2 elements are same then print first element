import java.util.Scanner;

public class Main
{
    public static void printunique(int arr[])
    {
        int count=1;
        int maxcount=1;
        int result=arr[0];
        for(int i = 0; i < arr.length-1; i++)
        {
            if(arr[i]==arr[i+1])
            {
                count++;
            }
            else
            {
                if(count>maxcount)
                {
                    maxcount=count;
                    result=arr[i];
                }
                count=1;
            }
        }
        if(count>maxcount)
        {
            maxcount=count;
            result=arr[arr.length-1];
        }
        System.out.print(result);
        
    }

    public static void main(String[] args)
    {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int arr[] = new int[n];

        for(int i = 0; i < n; i++)
        {
            arr[i] = sc.nextInt();
        }

        printunique(arr);
    }
}
