import java.util.Scanner;
public class Main
{
	public static void main(String[] args) 
	{
    Scanner scan=new Scanner(System.in);
    int n1=scan.nextInt();
    int n2=scan.nextInt();
    for(int num=n1;num<=n2;num++)
    {
    int arm=0,last=0,count=0;
    int n=num;
    int temp=n;
    while(n>0)
    {
       count++;
       n=n/10;
    }
    n=temp;
    while(n>0)
    {
        last=n%10;
        arm=arm+(int)Math.pow(last,count);
        n=n/10;
    }
    if(temp==arm)
    {
        System.out.print(temp+" ");
    }
    }
}
}
