import java.util.Scanner;
public class Main
{
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int rem;
		int count=0;
		if(n<0)
		{
		    n=n*-1;
		}
	    while(n!=0)
	    {
	        rem=n%10;
	        if(rem==2||rem==3||rem==5||rem==7)
	        {
	            count++;
	        }
	        n=n/10;
	    }
	    System.out.print(count);
	}
}
