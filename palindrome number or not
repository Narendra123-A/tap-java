import java.util.Scanner;
public class Main
{
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int rem;
		int temp=n;
		int rev=0;
		int sign=n<0 ? -1 : 1;
		n=Math.abs(n);
	    while(n!=0)
	    {
	        rem=n%10;
	        rev=rev*10+rem;
	        n=n/10;
	    }
	    rev=rev*sign;
	    if(temp==rev)
	    {
	        System.out.print("palindrome");
	    }
	    else
	    {
	        System.out.print("Not Palindrome");
	    }
	}
}
