import java.util.Scanner;
public class Main
{
    public static boolean checkprime(int n)
    {
        if(n<=1)
        {
            return false;
        }
        for(int i=2;i*i<=n;i++)
        {
            if(n%i==0)
            {
                return false;
            }
        }
        return true;
    }
    public static void printpairsdifference(int arr[])
    {
        for(int i=0;i<arr.length-1;i++)
        {
            for(int j=i+1;j<arr.length;j++)
            {
                if(checkprime(arr[i]+arr[j]))
                {
                    System.out.println(arr[i]+" "+arr[j]);
                }
            }
        }
    }
    
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int arr[]=new int[n];
		for(int i=0;i<n;i++)
		{
		    arr[i]=sc.nextInt();
		}
		printpairsdifference(arr);
	}
}
